generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String
  isActive   Boolean   @default(false)
  activatedAt DateTime?
  tokens     Int       @default(0)
  tokenDebt  Int       @default(0)
  isAdmin    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  dni              DniData?
  processedPayments ProcessedPayment[]
  paymentOrders     PaymentOrder[]
}

model ProcessedPayment {
  id        String        @id
  userId    String
  orderId   String?
  quantity  Int?
  amount    Int?
  currency  String?
  status    String        @default("approved")
  creditedQuantity Int?   // null = historical credited pack; 0 = reversal recorded before credit
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model PaymentOrder {
  id           String            @id @default(cuid())
  userId       String
  packId       String
  quantity     Int
  amount       Int
  currency     String            @default("ARS")
  preferenceId String?           @unique
  providerOrderId String?
  paymentId    String?           @unique
  checkoutUrl  String?
  creationState String           @default("new")
  creationStartedAt DateTime?
  creationPayload Json?
  status       String            @default("pending")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  processed    ProcessedPayment[]

  @@index([userId, status, createdAt])
  @@index([providerOrderId])
}

model PaymentReconciliationIssue {
  id         String   @id
  provider   String
  resourceId String
  reason     String
  status     String   @default("retry")
  attempts   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, updatedAt])
}

model RevokedSession {
  id        String   @id
  expiresAt DateTime
  @@index([expiresAt])
}

model RateLimitBucket {
  id      String   @id
  count   Int
  resetAt DateTime
  @@index([resetAt])
}

model DniData {
  id              String   @id @default(cuid())
  userId          String   @unique
  nombre          String
  apellido        String
  dniNumero       String
  domicilio       String
  nacimiento      String
  fechaEmision    String
  sexo            String
  firma           String?  // Legacy Base64 data URI; cleared only after verified R2 migration
  foto            String?  // Legacy Base64 data URI; cleared only after verified R2 migration
  firmaStorageKey  String? // Private object key in Cloudflare R2
  fotoStorageKey   String? // Private object key in Cloudflare R2
  userId_value    String   // The DNI document number for display
  tramiteNumero   String   // Tramite number
  ejemplar        String   @default("A")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
